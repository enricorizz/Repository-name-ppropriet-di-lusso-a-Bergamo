# Rizzetti Immobiliare — OpenClaw Workspace
# Copia questo file come .env e compila SOLO i valori che usi.
# NON committare il file .env reale nel repository.
#
# Per la configurazione completa di OpenClaw (provider IA, canali, gateway)
# segui: https://github.com/openclaw/openclaw
# e usa il comando: openclaw onboard --install-daemon

# ---------------------------------------------------------------------------
# Percorso workspace (opzionale — default: ~/.openclaw/workspace)
# ---------------------------------------------------------------------------
# OPENCLAW_WORKSPACE_DIR=~/.openclaw/workspace

# ---------------------------------------------------------------------------
# Gateway OpenClaw (configurato da openclaw onboard)
# Lascia vuoto: OpenClaw genera il token automaticamente al primo avvio.
# ---------------------------------------------------------------------------
# OPENCLAW_GATEWAY_TOKEN=

# ---------------------------------------------------------------------------
# Provider IA — imposta almeno uno dopo l'onboarding
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Canali di messaggistica — configurati tramite openclaw onboard
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Catalog path (opzionale — default: data/properties.demo.json)
# ---------------------------------------------------------------------------
# CATALOG_PATH=data/properties.demo.json
