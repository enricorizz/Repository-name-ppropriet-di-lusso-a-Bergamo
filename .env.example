# ─────────────────────────────────────────────────────────────
#  Rizzetti Immobiliare — Configurazione ambiente
#  Copia questo file in ".env" e compila i valori.
#  NON committare mai il file .env con valori reali.
# ─────────────────────────────────────────────────────────────

# Porta del server (default 3000)
PORT=3000

# ── Agente IA (opzionale) ────────────────────────────────────
# Se impostata, l'assistente virtuale usa il modello Claude.
# Senza chiave, l'assistente funziona comunque in modalità
# "esperto locale" (regole + knowledge base del sito).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Notifica lead / contatti (opzionale) ─────────────────────
# Indirizzo a cui inoltrare i contatti ricevuti dal sito.
LEADS_EMAIL=enrico@rizzetti.it

# SMTP per l'invio email (opzionale — se assente i lead
# vengono comunque salvati su file in data/leads/).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Rizzetti Immobiliare <no-reply@rizzetti.it>"

# ── Sicurezza ────────────────────────────────────────────────
# Origini consentite per le API (CORS). Separare con virgola.
ALLOWED_ORIGINS=http://localhost:3000
